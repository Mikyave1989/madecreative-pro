{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd ../.. && npm run build --workspace=@madecreative/marketing",
  "outputDirectory": ".next",
  "installCommand": "cd ../.. && npm install",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "https://app.madecreative.pro",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "https://admin.madecreative.pro",
      "permanent": false
    }
  ]
}
