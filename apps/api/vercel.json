{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/**", "prisma/**", "../../packages/*/dist/**"],
        "maxLambdaSize": "50mb",
        "maxDuration": 300
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "src/index.ts" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "STRIPE_PRICE_ID": "price_1TMp1bPpUruzeNQ3MZsGWxzz"
  }
}
