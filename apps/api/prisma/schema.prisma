generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Prospect {
  id                 String          @id @default(cuid())
  companyName        String
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  website            String?
  googleMapsUrl      String?
  googleRating       Float?
  reviewCount        Int?
  country            String
  city               String?
  region             String?
  sector             String
  employeeEstimate   Int?
  hasWebsite         Boolean         @default(false)
  websiteQuality     Int?
  socialPresence     Int?
  leadScore          Int             @default(0)
  painPoints         Json?
  suggestedServices  Json?
  aiAnalysis         String?
  previewSiteUrl     String?
  previewGeneratedAt DateTime?
  status             String          @default("SCRAPED")
  // SCRAPED → QUALIFIED → PREVIEW_READY → CONTACTED → FOLLOWED_UP → REPLIED → CONVERTED → LOST → BLACKLISTED
  source             String
  scrapeJobId        String?
  firstContactedAt   DateTime?
  lastContactedAt    DateTime?
  repliedAt          DateTime?
  convertedAt        DateTime?
  clientId           String?         @unique
  client             Client?         @relation(fields: [clientId], references: [id])
  outreachEmails     OutreachEmail[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([country, sector, leadScore])
  @@index([status])
  @@index([contactEmail])
}

model OutreachEmail {
  id              String    @id @default(cuid())
  prospectId      String
  prospect        Prospect  @relation(fields: [prospectId], references: [id])
  stepNumber      Int
  subject         String
  body            String
  bodyPlain       String?
  language        String
  fromName        String?
  fromEmail       String?
  resendMessageId String?   @unique
  sentAt          DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  repliedAt       DateTime?
  bouncedAt       DateTime?
  cancelledAt     DateTime?
  status          String    @default("draft")
  createdAt       DateTime  @default(now())

  @@index([prospectId, stepNumber])
  @@index([status])
  @@index([resendMessageId])
}

model Client {
  id               String         @id @default(cuid())
  companyName      String
  contactName      String
  email            String         @unique
  phone            String?
  passwordHash     String
  country          String
  city             String?
  sector           String
  language         String         @default("de")
  status           String         @default("ACTIVE")
  // ACTIVE, CHURNED, REFUNDED
  stripeCustomerId String?        @unique
  stripeSubId      String?        @unique
  lastLoginAt      DateTime?
  prospect         Prospect?
  website          ClientWebsite?
  chatbot          ClientChatbot?
  invoices         ClientInvoice[]
  reports          MonthlyReport[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model ClientWebsite {
  id              String   @id @default(cuid())
  clientId        String   @unique
  client          Client   @relation(fields: [clientId], references: [id])
  domain          String
  designTokens    Json?
  pages           Json
  deployUrl       String?
  lighthouseScore Int?
  monthlyVisits   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ClientChatbot {
  id                 String   @id @default(cuid())
  clientId           String   @unique
  client             Client   @relation(fields: [clientId], references: [id])
  knowledgeBase      Json
  widgetConfig       Json?
  isActive           Boolean  @default(true)
  totalConversations Int      @default(0)
  resolvedRate       Float    @default(0)
  createdAt          DateTime @default(now())
}

model ClientInvoice {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id])
  stripeInvoiceId String?   @unique
  amount          Float
  status          String    @default("PENDING")
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
}

model MonthlyReport {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  month     Int
  year      Int
  data      Json
  pdfUrl    String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
}

model AgentJob {
  id          String    @id @default(cuid())
  agentType   String
  status      String    @default("QUEUED")
  input       Json
  output      Json?
  progress    Int       @default(0)
  error       String?
  apiCost     Float?
  prospectId  String?
  clientId    String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model ScrapeConfig {
  id              String    @id @default(cuid())
  name            String
  sector          String
  countries       Json
  cities          Json?
  keywords        Json
  excludeKeywords Json?
  minRating       Float?
  maxResults      Int       @default(100)
  isActive        Boolean   @default(true)
  lastRunAt       DateTime?
  totalFound      Int       @default(0)
  schedule        String?
  createdAt       DateTime  @default(now())
}
