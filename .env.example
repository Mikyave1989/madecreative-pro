# ─────────────────────────────────────────────────────────────────────────────
# MadeCreative — Environment Variables
# Copy this file to .env and fill in every value before running any service.
# Run `npx tsx scripts/check-env.ts` to validate all required variables.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (Supabase / PostgreSQL) ────────────────────────────────────────
# Use the pooler connection string (port 6543) for the API and workers.
# Use the direct connection string (port 5432) for Prisma migrations only.
DATABASE_URL=postgresql://postgres:password@localhost:5432/madecreative
DIRECT_URL=postgresql://postgres:password@localhost:5432/madecreative

# ─── Redis (Upstash) ─────────────────────────────────────────────────────────
# BullMQ queues and distributed locks. Use Upstash EU (Frankfurt) for prod.
REDIS_URL=redis://localhost:6379

# ─── AI (Anthropic) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Google Stitch (AI UI Design) ───────────────────────────────────────────
# Optional: enables premium AI-generated UI via Google Stitch.
# Get your key at https://stitch.withgoogle.com/ (free, 350 generations/month).
# If not set, the builder uses the template engine with premium animations.
STITCH_API_KEY=

# ─── Auth ────────────────────────────────────────────────────────────────────
# Both secrets must be at least 32 characters long.
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars

# Default admin account (created by seed script).
ADMIN_EMAIL=admin@madecreative.pro
ADMIN_PASSWORD=your-admin-password

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Use sk_test_... and a Stripe CLI webhook secret for local development.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from Stripe dashboard (Products > Prices).
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_GROWTH_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# Verified sending domain in Resend. Must have SPF + DKIM + DMARC configured.
EMAIL_DOMAIN=madecreative.pro
EMAIL_FROM_DEFAULT=hello@madecreative.pro

# Comma-separated sender persona first names (rotated per prospect).
EMAIL_FROM_NAMES=marco,anna,luca,sarah,thomas

# Hard cap on emails sent per day across all outreach workers.
EMAIL_DAILY_LIMIT=200

# Where monitoring-worker sends admin alerts.
ADMIN_ALERT_EMAIL=alerts@madecreative.pro

# ─── Scraping ─────────────────────────────────────────────────────────────────
# BrightData proxy — required for large-scale Google Maps scraping.
BRIGHTDATA_API_KEY=...

# Google Maps Places API — optional fallback.
GOOGLE_MAPS_API_KEY=...

# ─── Storage (Cloudflare R2) ──────────────────────────────────────────────────
# R2 stores generated websites, social images, and PDF reports.
# CLOUDFLARE_R2_* are the canonical names used by check-env.ts and workers.
CLOUDFLARE_R2_BUCKET=madecreative-assets
CLOUDFLARE_R2_ACCESS_KEY=...
CLOUDFLARE_R2_SECRET_KEY=...
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Legacy aliases kept for backward compatibility with older packages.
R2_ACCESS_KEY_ID=${CLOUDFLARE_R2_ACCESS_KEY}
R2_SECRET_ACCESS_KEY=${CLOUDFLARE_R2_SECRET_KEY}
R2_BUCKET=${CLOUDFLARE_R2_BUCKET}
R2_ENDPOINT=${CLOUDFLARE_R2_ENDPOINT}

# ─── Deployment (Vercel) ──────────────────────────────────────────────────────
# Required for programmatic preview deployments via the Vercel API.
VERCEL_TOKEN=...
VERCEL_TEAM_ID=team_...

# ─── Media ───────────────────────────────────────────────────────────────────
# Stock photography used by the website builder agent.
PEXELS_API_KEY=...
UNSPLASH_ACCESS_KEY=...

# ─── Social Media (Meta) ──────────────────────────────────────────────────────
# Create a Meta for Developers app at https://developers.facebook.com.
# Requires instagram_content_publish and pages_manage_posts permissions.
META_APP_ID=...
META_APP_SECRET=...
META_PAGE_ACCESS_TOKEN=...
META_INSTAGRAM_ACCOUNT_ID=...
META_PAGE_ID=...

# AES-256 key for encrypting stored client social tokens in the database.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOCIAL_ENCRYPTION_KEY=your-32-char-encryption-key

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=...

# ─── URLs ─────────────────────────────────────────────────────────────────────
# Public-facing URLs — used for cross-service links, CORS config, and emails.
MARKETING_URL=https://madecreative.pro
ADMIN_URL=https://admin.madecreative.pro
PORTAL_URL=https://app.madecreative.pro
PREVIEW_URL=https://preview.madecreative.pro
API_URL=https://api.madecreative.pro
ASSETS_URL=https://assets.madecreative.pro

# ─── Next.js Public Variables (exposed to the browser) ───────────────────────
NEXT_PUBLIC_API_URL=https://api.madecreative.pro
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ─── Tools & Runtime ─────────────────────────────────────────────────────────
# ffmpeg path — used by the social worker for video processing.
FFMPEG_PATH=/usr/bin/ffmpeg

NODE_ENV=development
PORT=8000
