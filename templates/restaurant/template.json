{
  "sector": "restaurant",
  "fonts": {
    "heading": "Cormorant Garamond",
    "body": "DM Sans",
    "weights": [300, 400, 500, 600, 700],
    "google_fonts_url": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&display=swap"
  },
  "defaultColors": {
    "primary": "#1a1208",
    "accent": "#c9a84c",
    "background": "#faf8f4",
    "text": "#2d2419",
    "textLight": "#6b5c42",
    "border": "#e8e0d0",
    "surface": "#ffffff"
  },
  "sections": ["hero", "about", "menu_preview", "gallery", "testimonials", "contact"],
  "heroVariant": "split_parallax",
  "animationPreset": "elegant_fade",
  "components": {
    "hero": { "variant": "split_parallax", "hasGrainOverlay": true, "hasMouseParallax": true },
    "about": { "variant": "story_split", "hasQuote": true },
    "menu_preview": { "variant": "category_grid", "columnsDesktop": 2, "columnsMobile": 1 },
    "gallery": { "variant": "masonry", "columnsDesktop": 5, "columnsMobile": 2, "hasLightbox": true },
    "testimonials": { "variant": "carousel_autoplay", "hasAggregateRating": true },
    "contact": { "variant": "split_map", "hasReservationDate": true, "hasGDPR": true }
  },
  "seoDefaults": {
    "titleTemplate": "%s | Ristorante",
    "defaultDescription": "Scopri la nostra cucina autentica. Prenota un tavolo e vivi un'esperienza gastronomica unica.",
    "ogImageAspectRatio": "1200x630",
    "structuredDataType": "Restaurant"
  },
  "animations": {
    "heroEntrance": "character_reveal",
    "scrollReveal": "elegant_fade",
    "navTransition": "transparent_to_solid",
    "imageReveal": "wipe",
    "ctaHover": "magnetic",
    "carouselTransition": "slide_fade"
  },
  "lighthouse": {
    "performance": 90,
    "accessibility": 90,
    "seo": 95
  }
}
